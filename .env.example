# Copy to .env and fill in. Keys marked (required) stop the worker at startup if empty.

# --- LiveKit (required) ------------------------------------------------------
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match agentName on the SIP dispatch rule.
AGENT_NAME=bush-bush-intake

# --- Deepgram Flux STT -------------------------------------------------------
DEEPGRAM_API_KEY=
STT_MODEL=flux-general-en
STT_EAGER_EOT_THRESHOLD=0.4
STT_EOT_THRESHOLD=0.7
STT_EOT_TIMEOUT_MS=5000

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.55
ROUTER_LLM_MODEL=gpt-4.1-mini
ROUTER_LLM_TEMPERATURE=0.3
POST_CALL_ANALYSIS_MODEL=gpt-5-mini

# --- Groq LLM (optional, lower time-to-first-token) ---------------------------
# On: the conversation and router models below are used instead of the OpenAI
# ones above. Post-call analysis always stays on OpenAI.
ENABLE_GROQ_LLM=false
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_LLM_MODEL=llama-3.1-8b-instant

# --- ElevenLabs TTS (custom voice) --------------------------------------------
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_LANGUAGE=en
ELEVEN_SPEED=1.12
ELEVEN_STABILITY=0.425
ELEVEN_SIMILARITY_BOOST=0.75
ELEVEN_STYLE=0.0
ELEVEN_USE_SPEAKER_BOOST=true
ELEVEN_PRONUNCIATION_DICT_ID=
ELEVEN_PRONUNCIATION_DICT_VERSION_ID=

# --- Call behavior -----------------------------------------------------------
MAX_CALL_DURATION_S=664
USER_AWAY_TIMEOUT_S=10
SILENCE_REMINDERS=2
INTERRUPTION_MIN_DURATION_S=0.25

# --- Post-call ---------------------------------------------------------------
# Every call is saved to CALL_RECORDS_DIR; webhooks are optional.
POST_CALL_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
POST_CALL_WEBHOOK_TIMEOUT_S=10
CALL_RECORDS_DIR=./call_records
# Comma-separated. Calls from these numbers are tagged as tests, not skipped.
TEST_PHONE_NUMBERS=

# Postgres, e.g. postgresql://user:pass@host:5432/bblg_livekit_intake. Empty: JSON files only.
# The tables (user_data, practice-area tables, session_tracking, error_events,
# intake_calls) are created on the first call; the database must already exist.
DATABASE_URL=

# --- Intake email (SendGrid) --------------------------------------------------
# Sent for every call that reached a practice area, with the priority PDF,
# the record as JSON and the recording attached.
ENABLE_LEGAL_EMAILS=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Comma-separated. Every intake goes to LEGAL_TEAM_EMAILS; the practice-area
# lists are added on top for their own calls.
LEGAL_TEAM_EMAILS=
ACCIDENT_EMAILS=
EMPLOYMENT_EMAILS=
PREMISES_LIABILITY_EMAILS=
SEXUAL_HARASSMENT_EMAILS=
MEDICAL_MALPRACTICE_EMAILS=
# Recordings larger than this are linked instead of attached.
EMAIL_MAX_RECORDING_MB=20

# --- Call recording --------------------------------------------------------
# Attached to the intake email and saved on the call record.
ENABLE_CALL_RECORDING=false
# twilio: as in the old build, Twilio records the call on the SIP trunk
#   (turn on Call Recording for the trunk in the Twilio console) and the MP3
#   is downloaded by Call SID after hangup.
# egress: LiveKit egress records the room into the S3-compatible bucket below.
RECORDING_SOURCE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Only for RECORDING_SOURCE=egress.
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
# Only for non-AWS storage (Cloudflare R2, DigitalOcean Spaces, MinIO).
RECORDING_S3_ENDPOINT=
RECORDING_PREFIX=recordings/
# Lifetime of the recording link in emails and webhooks (max 7 days).
RECORDING_LINK_TTL_S=604800
# How long post-call waits for the recording after hangup.
RECORDING_FINISH_TIMEOUT_S=45

# --- Control API (api/server.py) ----------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# Worker health-check HTTP port (8081/8082 are used by the older services).
AGENT_HTTP_PORT=8083

# --- Live transfers -------------------------------------------------------
# Off by default: the agent promises an attorney callback instead of dialing.
ENABLE_LIVE_TRANSFERS=false
# E.164, e.g. +12145550101
ATTORNEY_LINE=
RECEPTION_LINE=
# Seconds the caller waits while the line rings before the AI takes over.
TRANSFER_RINGING_TIMEOUT_S=18

# --- Office hours (US Central, Mon-Fri) -----------------------------------
OFFICE_HOURS_START=8
OFFICE_HOURS_END=17
