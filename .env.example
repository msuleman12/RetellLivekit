# Copy to .env and fill in. Keys marked (required) stop the worker at startup if empty.

# --- LiveKit (required) ------------------------------------------------------
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match agentName on the SIP dispatch rule.
AGENT_NAME=bush-bush-intake

# --- Deepgram Flux STT -------------------------------------------------------
DEEPGRAM_API_KEY=
STT_MODEL=flux-general-en
STT_EAGER_EOT_THRESHOLD=0.4
STT_EOT_THRESHOLD=0.7
STT_EOT_TIMEOUT_MS=5000

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.55
ROUTER_LLM_MODEL=gpt-4.1-mini
ROUTER_LLM_TEMPERATURE=0.3
POST_CALL_ANALYSIS_MODEL=gpt-5-mini

# --- Groq LLM (optional, lower time-to-first-token) ---------------------------
# On: the conversation and router models below are used instead of the OpenAI
# ones above. Post-call analysis always stays on OpenAI.
ENABLE_GROQ_LLM=false
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_LLM_MODEL=llama-3.1-8b-instant

# --- ElevenLabs TTS (custom voice) --------------------------------------------
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_LANGUAGE=en
ELEVEN_SPEED=1.12
ELEVEN_STABILITY=0.425
ELEVEN_SIMILARITY_BOOST=0.75
ELEVEN_STYLE=0.0
ELEVEN_USE_SPEAKER_BOOST=true
ELEVEN_PRONUNCIATION_DICT_ID=
ELEVEN_PRONUNCIATION_DICT_VERSION_ID=

# --- Call behavior -----------------------------------------------------------
MAX_CALL_DURATION_S=664
USER_AWAY_TIMEOUT_S=10
SILENCE_REMINDERS=2
INTERRUPTION_MIN_DURATION_S=0.25

# --- Post-call ---------------------------------------------------------------
# Every call is saved to CALL_RECORDS_DIR; webhooks are optional.
POST_CALL_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
POST_CALL_WEBHOOK_TIMEOUT_S=10
CALL_RECORDS_DIR=./call_records

# --- Control API (api/server.py) ----------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# Worker health-check HTTP port (8081/8082 are used by the older services).
AGENT_HTTP_PORT=8083

# --- Live transfers -------------------------------------------------------
# Off by default: the agent promises an attorney callback instead of dialing.
ENABLE_LIVE_TRANSFERS=false
# E.164, e.g. +12145550101
ATTORNEY_LINE=
RECEPTION_LINE=
# Seconds the caller waits while the line rings before the AI takes over.
TRANSFER_RINGING_TIMEOUT_S=18

# --- Office hours (US Central, Mon-Fri) -----------------------------------
OFFICE_HOURS_START=8
OFFICE_HOURS_END=17
