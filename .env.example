# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# --- LiveKit -----------------------------------------------------------------
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent name the SIP dispatch rule targets (see scripts/setup_sip.py)
AGENT_NAME=bush-bush-intake

# --- Latency profile --------------------------------------------------------
# parity = Retell timing numbers (default). fast = lower STT/endpointing waits
# + VAD turn detection (not cloud) + preemptive TTS. With fast, omit
# STT_ENDPOINTING_MS / RESPONSIVENESS to use profile defaults (200ms / 1.0).
LATENCY_PROFILE=parity

# --- Speech-to-text (Deepgram) ----------------------------------------------
# Retell used: provider=deepgram, endpointing_ms=450
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=en-US
# Leave empty to follow LATENCY_PROFILE (parity=450, fast=200)
STT_ENDPOINTING_MS=

# --- LLM (OpenAI) ------------------------------------------------------------
# Retell: practice agents = gpt-4.1-mini @ 0.55, router flow = gpt-4.1-nano
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.55
ROUTER_LLM_MODEL=gpt-4.1-nano
ROUTER_LLM_TEMPERATURE=0.3

# Retell: post_call_analysis_model = gpt-5-mini
POST_CALL_ANALYSIS_MODEL=gpt-5-mini

# Live field capture (src/extract.py). Retell filled its analysis fields with a
# second model AFTER the call, which is why the speaking model never carried a
# checklist. This runs that same idea DURING the call, in the background, so
# Claire stays conversational and still never re-asks something she was told.
# Leave it as-is unless you want to trade accuracy for cost.
LIVE_EXTRACT_MODEL=gpt-4.1-mini
LIVE_EXTRACT_TIMEOUT_MS=6000

# How long the router waits for its case-type classification before giving up
# and asking one clarifying question instead. Retell's flow ran this on
# gpt-4.1-nano (ROUTER_LLM_MODEL above).
ROUTER_CLASSIFY_TIMEOUT_MS=2500

# --- Text-to-speech (ElevenLabs) --------------------------------------------
# Retell used voice "11labs-Nico" with model eleven_flash_v2_5.
# Put the ElevenLabs voice_id for Nico (or whichever voice you licensed) here.
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=eleven_flash_v2_5
# American English pronunciation for TTS (BCP-47)
ELEVEN_LANGUAGE=en-US
# Retell voice_speed = 1.12
ELEVEN_SPEED=1.12
# Derived from Retell voice_temperature = 1.15  ->  stability 0.425
ELEVEN_STABILITY=0.425
ELEVEN_SIMILARITY_BOOST=0.75
ELEVEN_STYLE=0.0
ELEVEN_USE_SPEAKER_BOOST=true
# Optional ElevenLabs pronunciation dictionary (Retell's pronunciation_dictionary).
# If you create one in the ElevenLabs dashboard, put its ids here; otherwise the
# local phonetic-respelling fallback in src/pronunciation.py is used.
ELEVEN_PRONUNCIATION_DICT_ID=
ELEVEN_PRONUNCIATION_DICT_VERSION_ID=

# --- Turn taking / call behaviour (Retell parity) ---------------------------
# Retell interruption_sensitivity = 0.85
INTERRUPTION_SENSITIVITY=0.85
# Retell responsiveness = 0.95. Leave empty to follow LATENCY_PROFILE
# (parity=0.95, fast=1.0). Fast also caps endpointing max_delay at 1.5s.
RESPONSIVENESS=
# Retell max_call_duration_ms = 664000 (11 min 4 s)
MAX_CALL_DURATION_MS=664000
# Retell end_call_after_silence_ms = 261000
END_CALL_AFTER_SILENCE_MS=261000
# Retell reminder_trigger_ms / reminder_max_count
REMINDER_TRIGGER_MS=10000
REMINDER_MAX_COUNT=2
# Retell begin_message_delay_ms
BEGIN_MESSAGE_DELAY_MS=0
# Retell ring_duration_ms = 17000
RING_DURATION_MS=17000
# LiveKit Cloud noise cancellation: BVCTelephony | BVC | off
NOISE_CANCELLATION=BVCTelephony
# LiveKit Cloud turn detector model (set false to fall back to VAD-only).
# Cloud ML turn detector (parity only). fast always forces turn_detection=vad
# because omitting it still defaults AgentSession to inference.TurnDetector().
USE_TURN_DETECTOR=true

# --- Post-call analysis / webhook -------------------------------------------
# Retell posted `call_analyzed` to a Zapier catch hook. Put yours here.
POST_CALL_WEBHOOK_URL=
# The flat, Zapier-shaped payload the old ai-receptionist build sent
# (user / <agent_name> / metadata sections, timestamps in CST). Set this
# only if the firm's existing Zap was built against that shape. It is
# delivered IN ADDITION to POST_CALL_WEBHOOK_URL, not instead of it.
ZAPIER_WEBHOOK_URL=
POST_CALL_WEBHOOK_TIMEOUT_MS=10000
# Cap post-call LLM extraction so job shutdown cannot hang indefinitely.
POST_CALL_ANALYSIS_TIMEOUT_MS=8000
# Every call is also written to this folder as JSON.
CALL_RECORDS_DIR=./call_records

# --- Control API -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Shared secret required in the `x-api-key` header of every control-API request.
API_KEY=change-me
