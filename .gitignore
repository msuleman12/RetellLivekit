# Secrets - .env holds every API key. .env.example stays tracked.
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/

# Call records contain client data; they stay on the machine that took the call.
call_records/

# Runtime output
*.log
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
